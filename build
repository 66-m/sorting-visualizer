#!/bin/sh
# build script for Unix-like systems
# Use: ./build             — package with tests
#      ./build skip-tests  — fast incremental build (no tests)
#      ./build release     — full clean build with fat jar (for releases)

# ensure Maven wrapper is executable
chmod +x ./mvnw

if [ "$1" = "release" ]; then
    ./mvnw clean package -Prelease
elif [ "$1" = "skip-tests" ]; then
    ./mvnw package -DskipTests
else
    ./mvnw package
fi
