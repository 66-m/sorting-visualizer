#!/bin/sh
# run the packaged JAR

if [ ! -f ./target/sorting-visualizer.jar ]; then
    echo "Jar not found, please build first (./build) or run ./mvnw package."
    exit 1
fi

java --enable-native-access=ALL-UNNAMED \
  --add-opens=java.desktop/com.sun.media.sound=ALL-UNNAMED \
  -cp "target/sorting-visualizer.jar:target/dependency/*" \
  io.github.compilerstuck.control.DesktopLauncher "$@"
